"Employer":{"label":"用工企业","comment":"提出用工需求，确认人员或服务结果，并支付招聘费、外包费或结算费用的企业主体。","properties":{
"founded_months":{"value":8,"value_source":"B16｜Y｜派生:B04,A06｜(2026-2026)*12+(11-3)=8；基准日4≥成立日1，不再减1","label":"成立月数","comment":null,"extractIds":["B16"],"rules":[{"ruleId":"RULE-ADM-002","label":"成立不足三个月严格禁入","comment":"自营业执照成立日期起算至企业点击确认报价当天，不足 3 个月的严格禁入，不得以补充材料、追加担保等方式变通｜适用阶段：准入","condition":"Employer.founded_months < 3"},{"ruleId":"RULE-ADM-003","label":"成立三至六个月须经营佐证","comment":"成立满 3 个月不满 6 个月的，须提供经营佐证材料并经审核通过后方可准入；佐证材料范围参照补充材料｜适用阶段：准入","condition":"Employer.founded_months >= 3 AND Employer.founded_months < 6 AND Employer.support_evidence_ready = false"},{"ruleId":"RULE-ADM-010","label":"成立不足六个月靠佐证准入但佐证不足按不予准入","comment":"成立满 3 个月不满 6 个月、本应凭经营佐证准入，但佐证材料仍不能证明主营真实存在的，结论为不予准入；不作禁入｜适用阶段：准入","condition":"Employer.founded_months >= 3 AND Employer.founded_months < 6 AND Employer.support_evidence_ready = true AND Employer.main_business_verifiable = false"}]},
"has_independent_employment_status":{"value":true,"value_source":"派生:B17,B18,B19｜有限责任公司，B18、B19 均为 false","label":"具备独立用工主体资格","comment":null,"extractIds":["B17","B18","B19"],"rules":[{"ruleId":"RULE-ADM-001","label":"企业类型须为企业法人或其他合法组织","comment":"以营业执照载明的主体类型为准；个体工商户、个人独资企业禁入；分公司、合伙企业、其他合法组织不具备独立用工主体资格的按禁入处理｜适用阶段：准入","condition":"Employer.subject_type IN {sole_proprietor, sole_ownership} OR (Employer.subject_type IN {branch, partnership, other_org} AND Employer.has_independent_employment_status = false)"},{"ruleId":"RULE-ADM-012","label":"独立用工结论须有判断依据","comment":"具备独立用工主体资格但取不到判断依据的，结论不能是可以通过，转人工复核并补齐依据｜适用阶段：准入","condition":"Employer.has_independent_employment_status = true AND Employer.independent_employment_evidence_ready = false"}]},
"employer_id":{"value":"123456","value_source":"A01｜Y｜请求 entpId｜entpId=123456","label":"企业ID","comment":null,"extractIds":["A01"],"rules":[]},
"employer_name":{"value":"示例科技有限公司","value_source":"A02｜Y｜请求 entpName｜entpName=示例科技有限公司","label":"企业名称","comment":null,"extractIds":["A02"],"rules":[{"ruleId":"RULE-RISK-001","label":"名称命中从严不直接拦截","comment":"公司名称命中行业黑名单关键词的，不因名称直接拦截，必须进入实际业务核查并从严判断；资料不全一律转人工复核｜适用阶段：准入","condition":"Employer.employer_name CONTAINS \"金融\" OR Employer.employer_name CONTAINS \"保险\" OR Employer.employer_name CONTAINS \"担保\" OR Employer.employer_name CONTAINS \"资产管理\" OR Employer.employer_name CONTAINS \"医药\" OR Employer.employer_name CONTAINS \"医疗\" OR Employer.employer_name CONTAINS \"建筑\" OR Employer.employer_name CONTAINS \"工程\" OR Employer.employer_name CONTAINS \"采矿业\" OR Employer.employer_name CONTAINS \"能源业\" OR Employer.employer_name CONTAINS \"律师\" OR Employer.employer_name CONTAINS \"会计师\" OR Employer.employer_name CONTAINS \"税务师\" OR Employer.employer_name CONTAINS \"资产评估师\" OR Employer.employer_name CONTAINS \"影视\" OR Employer.employer_name CONTAINS \"电视剧\" OR Employer.employer_name CONTAINS \"人力资源\" OR Employer.employer_name CONTAINS \"劳务\""}]}
