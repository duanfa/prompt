{
  "$comment": "绑定 schema：仅 input、notes、summary 三个顶层字段。参数来源只保存在 work/<requestId>/input-extract-detail.json（提取明细）和 input-combine.json（本体组装），不输出 extractionReport。",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": true,
      "description": "与最后一次成功调用 mcp_run_process 的 request.input 完全一致"
    },
    "notes": {
      "type": "object",
      "properties": {
        "unresolvedProperties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "v24：提取明细（全部清单条目）里 value 为 null 的条目，加 input-combine.unfilled 的登记；每条 名称｜原因码(R01-R15)｜具体原因；同原因的多个键可合并但须列具体键"
        },
        "notFoundInDefinition": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unreadMaterials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "toolIssues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "unresolvedProperties",
        "notFoundInDefinition",
        "conflicts",
        "unreadMaterials",
        "toolIssues"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "input",
    "notes",
    "summary"
  ],
  "additionalProperties": false
}
